# ==============================================================================
# DIGITAL USTAD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive credentials, secret keys, or tokens to version control.
# - The browser application (frontend JavaScript) must NEVER contain private secret API keys.
# - Public client identifiers (Tenant ID, Assistant ID, Public Embed URL) may be safely
#   exposed to the browser through js/config.js or window.DU_CONFIG.clonvo.
# - Server-side webhook endpoints, CRM API keys, and signature secrets must remain on your
#   secure server / Netlify environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLONVO WEBCHAT & ASSISTANT CONFIGURATION (OWNER INPUT REQUIRED)
# ------------------------------------------------------------------------------
# Official Clonvo script loader or SDK embed URL supplied in owner documentation
CLONVO_EMBED_URL=

# Official Clonvo API Base URL (if connecting via direct API rather than script embed)
CLONVO_API_URL=

# Official Clonvo Workspace / Tenant Identifier
CLONVO_TENANT_ID=

# Official Clonvo Production Assistant Identifier
CLONVO_ASSISTANT_ID=

# Official Clonvo Public Client Key (if public client-key authentication is required)
CLONVO_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (STRICTLY SERVER-SIDE — NEVER IN BROWSER JAVASCRIPT)
# ------------------------------------------------------------------------------
# Private Clonvo API Key (if using server-side session/token generation)
CLONVO_SECRET_API_KEY=

# Webhook signing secret used to verify Clonvo lead webhook signatures
CLONVO_WEBHOOK_SECRET=

# Destination CRM / Backend Lead Capture Webhook Endpoint
CLONVO_LEAD_ENDPOINT=

# ------------------------------------------------------------------------------
# 3. CONTACT & NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
# Verified business contact phone (E.164 without +) - to be supplied by business owner (e.g. 923XXXXXXXXX)
DU_VERIFIED_WHATSAPP_NUMBER=

# Verified notification email for qualified chat leads
DU_LEAD_NOTIFICATION_EMAIL=contact@digitalustad.co
