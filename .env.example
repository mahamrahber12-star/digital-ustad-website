# ==============================================================================
# DIGITAL USTAD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive credentials, secret keys, or tokens to version control.
# - The browser application (frontend JavaScript) must NEVER contain private secret API keys.
# - Public client identifiers (Tenant ID, Assistant ID, Public Embed URL) may be safely
#   exposed to the browser through js/config.js or window.DU_CONFIG.clonvo.
# - Server-side webhook endpoints, CRM API keys, and signature secrets must remain on your
#   secure server / Netlify environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLONVO.CHAT API & ASSISTANT CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL for Clonvo.chat (provided in your Clonvo developer dashboard)
CLONVO_API_URL=https://api.clonvo.chat/v1

# Clonvo Workspace / Tenant Identifier
# Required: Provided by business owner in Clonvo account settings
CLONVO_TENANT_ID=ten_digitalustad_prod_replace_with_actual

# Clonvo Production Assistant Identifier
# Required: Assistant trained strictly on Digital Ustad services, packages, and pricing
CLONVO_ASSISTANT_ID=asst_du_prod_replace_with_actual

# Clonvo Staging / Test Assistant Identifier (Optional: for staging/dev environments)
CLONVO_STAGING_ASSISTANT_ID=asst_du_staging_replace_with_actual

# Clonvo Public Client Key (if your Clonvo workspace uses public client-key authentication)
CLONVO_PUBLIC_KEY=pk_live_du_replace_with_actual

# Clonvo Hosted Embed Widget URL (Optional: if loading via Clonvo CDN script loader)
# Example: https://widget.clonvo.chat/v1/loader.js
CLONVO_EMBED_URL=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE WEBHOOK & CRM INTEGRATION (KEEP SECRET!)
# ------------------------------------------------------------------------------
# Webhook secret used to cryptographically verify Clonvo conversation/lead event signatures
# (Must NEVER be exposed in client-side HTML or JavaScript)
CLONVO_WEBHOOK_SECRET=sec_wh_replace_with_actual_secret_key

# Destination CRM / Backend Lead Capture Webhook Endpoint
# Where qualified chat leads are forwarded (e.g., Netlify function, Zapier, Make, or CRM webhook)
CLONVO_LEAD_ENDPOINT=https://api.digitalustad.co/api/leads

# ------------------------------------------------------------------------------
# 3. CONTACT & NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
# Verified business contact phone (E.164 without +) - to be verified by owner
DU_VERIFIED_WHATSAPP_NUMBER=923000000000

# Verified notification email for qualified chat leads
DU_LEAD_NOTIFICATION_EMAIL=contact@digitalustad.co
